## Swift / SwiftPM
.build/
.swiftpm/
*.xcodeproj/
*.xcworkspace/
DerivedData/

# Package.resolved is intentionally NOT ignored — the MLX/Transformers
# dependency graph is fragile across releases, and we want every machine to
# resolve to the same vetted versions.

## Apple
.DS_Store
xcuserdata/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

## Local model weights & recorded EEG (never committed by default)
Models/*
!Models/.gitkeep
!Models/README.md
Recordings/*
!Recordings/.gitkeep
!Recordings/README.md
# Raw EEG (Recordings/golden/*.csv etc.) still never leaves the machine —
# only the golden recording's own README and its derived report images
# (plots, not raw waveform data export) are deliberately committed.
!Recordings/golden/
Recordings/golden/*
!Recordings/golden/README.md
!Recordings/golden/report/

## Secrets — never commit API keys / tokens. `.env` holds HF_API_TOKEN and
## (optionally) ANTHROPIC_API_KEY for the offline dream-mode eval tool.
.env
.env.*
!.env.example

## Editors
.vscode/
.idea/
*.swp

## Logs / coverage
*.log
coverage/

## Python (training pipeline)
venv/
venv.*.parked/
__pycache__/
*.pyc

## Synthetic data outputs (regeneratable from Scripts/generate_synthetic_sleep.py)
Data/*
!Data/.gitkeep
!Data/synthetic_dream_reports.json
!Data/human_rated_dream_reports.json

## World Model spike — generated trajectories, regenerable via
## WorldModel/dataset.py (seeded, so --seed 0 reproduces exactly)
WorldModel/data/

## World Model spike — trained checkpoints, regenerable via WorldModel/train.py
WorldModel/checkpoints/

## World Model spike — generated telemetry visualizations, regenerable via
## WorldModel/telemetry.py
WorldModel/*.png

