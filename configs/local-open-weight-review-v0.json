{
  "schema_version": "nc-local-review-cascade-config-v0",
  "configuration_version": "local-open-weight-review-v0",
  "validator": {
    "id": "R0",
    "type": "deterministic"
  },
  "proposer": {
    "id": "R1",
    "model": "qwen3:0.6b",
    "purpose": "bounded_chunk_findings"
  },
  "reviewer": {
    "id": "R2",
    "preferred_model": "qwen3:4b",
    "fallback_model": "qwen3:1.7b",
    "purpose": "citation_repair_and_aggregation"
  },
  "critic": {
    "id": "R3",
    "model": "gemma-family-local",
    "purpose": "explicit_independent_adjudication",
    "enabled_by_default": false
  },
  "human_gate": {
    "id": "R4",
