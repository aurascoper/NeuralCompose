      "policy_changes",
      "experiment_changes",
      "scientific_claims",
      "promotion_decisions"
    ]
  },
  "chunking": {
    "valid_records_per_chunk": 16,
    "overlap_records": 2,
    "conversation_memory_between_chunks": false
  },
  "generation": {
    "temperature": 0.0,
    "seed": 42,
    "context_limit": 8192,
    "max_output_tokens": 2048
  },
  "retry": {
    "maximum_attempts": 3
  }
