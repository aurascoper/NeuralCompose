{
  "schema_version": "nc-eeg-preprocessing-v0",
  "channels": ["TP9", "AF7", "AF8", "TP10"],
  "target_sample_rate_hz": 256,
  "window_seconds": 4,
  "stride_seconds": 1,
  "filter": {
    "kind": "causal-sos",
    "bandpass_hz": [1, 45],
    "notch_hz": 60,
    "notch_quality_factor": 30,
    "order": 4
  },
  "normalization": {
    "kind": "per-session-calibration-zscore",
    "minimum_standard_deviation": 0.000001,
    "calibration_must_precede_task": true
  },
  "timestamp_validation": {
    "rate_tolerance_fraction": 0.05,
    "packet_gap_multiplier": 1.5
  },
  "resampling": {
    "kind": "identity-at-256-hz-only",
    "reason": "The pilot rejects non-256 Hz sources rather than using a non-causal offline resampler."
  }
}
