{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuralcompose.local/schemas/nc-eeg-fused-state-v1.schema.json",
  "title": "nc-eeg-fused-state-v1",
  "description": "W5 late-fusion state. Supersedes nc-eeg-fused-state-v0, which remains the frozen D0 evidence schema for the committed fusion-synthetic-v0 artifacts; those artifacts stay valid v0 records and are not migrated. v1 exists because v0 cannot represent a missing encoder: its fusion.status is a const 'complete' and its probability fields are root-required, so an unavailable fused state is unrepresentable without weakening the closed contract or invalidating committed evidence. v1 adds per-encoder and fusion completion status, with conditional requirements so a missing encoder fails closed instead of silently degrading to a one-model prediction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "state_id",
    "status",
    "data_gate",
    "decision",
    "promotion_status",
    "runtime_change",
    "source_type",
    "synthetic_only",
    "physical_eeg_used",
    "scientific_claim_allowed",
    "shadow_only",
    "live_control",
    "qwen_policy_stage",
    "source",
    "encoder_provenance",
    "fusion",
    "signal_quality",
    "calibration_scope"
  ],
  "properties": {
    "schema_version": { "const": "nc-eeg-fused-state-v1" },
    "experiment_id": { "const": "EXP-NC-EEG-FUSION-001" },
    "state_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },

    "status": { "const": "foundational_study_only" },
    "data_gate": { "const": "D0" },
    "decision": { "const": "insufficient_evidence" },
    "promotion_status": { "const": "not_eligible" },
    "runtime_change": { "const": "none" },
    "source_type": { "const": "deterministic_synthetic_fixture" },
    "synthetic_only": { "const": true },
    "physical_eeg_used": { "const": false },
    "scientific_claim_allowed": { "const": false },
    "shadow_only": { "const": true },
    "live_control": { "const": false },
    "qwen_policy_stage": { "const": "schema_validation_only" },
    "calibration_scope": { "const": "train_fold_only_not_fitted_at_d0" },

    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "source_record_sha256"],
      "properties": {
        "fixture_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source_record_sha256": { "$ref": "#/$defs/sha256" }
      }
    },

    "encoder_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eegnet", "eegpt"],
      "properties": {
        "eegnet": { "$ref": "#/$defs/eegnet_encoder" },
        "eegpt": { "$ref": "#/$defs/eegpt_encoder" }
      }
    },

    "fusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_id", "method", "completion_status", "trainable_parameters"],
      "properties": {
        "condition_id": { "const": "F2" },
        "method": { "const": "fixed_average_of_calibrated_probabilities" },
        "completion_status": {
          "enum": ["completed", "unavailable_due_to_missing_encoder"]
        },
        "trainable_parameters": { "const": 0 }
      }
    },

    "signal_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "missing_channels"],
      "properties": {
        "score": { "$ref": "#/$defs/probability" },
        "missing_channels": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["TP9", "AF7", "AF8", "TP10"] }
        }
      }
    },

    "artifact_probabilities": { "$ref": "#/$defs/artifact_probabilities" },
    "observable_state_probabilities": { "$ref": "#/$defs/observable_state_probabilities" },
    "encoder_disagreement": { "$ref": "#/$defs/probability" },
    "predictive_entropy": { "$ref": "#/$defs/probability" },
    "out_of_distribution_score": { "$ref": "#/$defs/probability" }
  },

  "allOf": [
    {
      "description": "A completed fusion must carry every fused quantity. This is the only branch that may.",
      "if": {
        "required": ["fusion"],
        "properties": {
          "fusion": {
            "required": ["completion_status"],
            "properties": { "completion_status": { "const": "completed" } }
          }
        }
      },
      "then": {
        "required": [
          "artifact_probabilities",
          "observable_state_probabilities",
          "encoder_disagreement",
          "predictive_entropy",
          "out_of_distribution_score"
        ]
      }
    },
    {
      "description": "A fused state that lost an encoder must not carry fused quantities. Emitting probabilities here would silently republish one model's prediction as a fusion result.",
      "if": {
        "required": ["fusion"],
        "properties": {
          "fusion": {
            "required": ["completion_status"],
            "properties": {
              "completion_status": { "const": "unavailable_due_to_missing_encoder" }
            }
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["artifact_probabilities"] },
            { "required": ["observable_state_probabilities"] },
            { "required": ["encoder_disagreement"] },
            { "required": ["predictive_entropy"] },
            { "required": ["out_of_distribution_score"] }
          ]
        }
      }
    }
  ],

  "$defs": {
    "probability": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },

    "artifact_probabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blink_artifact", "jaw_artifact", "head_motion_artifact"],
      "properties": {
        "blink_artifact": { "$ref": "#/$defs/probability" },
        "jaw_artifact": { "$ref": "#/$defs/probability" },
        "head_motion_artifact": { "$ref": "#/$defs/probability" }
      }
    },

    "observable_state_probabilities": {
      "description": "Protocol-observable states only. Cognitive, affective, intentional, and predictive-processing-derived labels are out of contract; see docs/science/predictive-processing-background.md.",
      "type": "object",
      "additionalProperties": false,
      "required": ["eyes_open", "eyes_closed", "listening", "speaking", "recovery"],
      "properties": {
        "eyes_open": { "$ref": "#/$defs/probability" },
        "eyes_closed": { "$ref": "#/$defs/probability" },
        "listening": { "$ref": "#/$defs/probability" },
        "speaking": { "$ref": "#/$defs/probability" },
        "recovery": { "$ref": "#/$defs/probability" }
      }
    },

    "encoder_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "completion_status"],
      "properties": {
        "model_id": { "enum": ["eegnet", "eegpt"] },
        "completion_status": { "enum": ["completed", "missing", "failed_validation"] },
        "model_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "backbone_frozen": { "const": true },
        "adapter": { "type": "string", "minLength": 1, "maxLength": 128 },
        "checkpoint_kind": {
          "enum": ["deterministic_synthetic_parameter_fixture", "pinned_upstream_checkpoint"]
        },
        "checkpoint_sha256": { "$ref": "#/$defs/sha256" },
        "configuration_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "description": "Identity and provenance are required exactly when the encoder completed. An absent encoder must not be described as if it had run.",
          "if": {
            "required": ["completion_status"],
            "properties": { "completion_status": { "const": "completed" } }
          },
          "then": {
            "required": [
              "model_revision",
              "backbone_frozen",
              "adapter",
              "checkpoint_kind",
              "checkpoint_sha256",
              "configuration_sha256"
            ]
          }
        },
        {
          "description": "A missing encoder carries no checkpoint identity.",
          "if": {
            "required": ["completion_status"],
            "properties": { "completion_status": { "const": "missing" } }
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["checkpoint_sha256"] },
                { "required": ["configuration_sha256"] }
              ]
            }
          }
        }
      ]
    },

    "eegnet_encoder": {
      "allOf": [
        { "$ref": "#/$defs/encoder_identity" },
        { "properties": { "model_id": { "const": "eegnet" } } }
      ]
    },

    "eegpt_encoder": {
      "allOf": [
        { "$ref": "#/$defs/encoder_identity" },
        { "properties": { "model_id": { "const": "eegpt" } } }
      ]
    }
  }
}
