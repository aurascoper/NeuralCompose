# NeuralCompose Pixel 8a local service configuration
# Copy to .runtime/neuralcompose/neuralcompose-services.env and edit

# Qwen generation server
QWEN_PORT=8081
QWEN_MODEL=$HOME/models/qwen2.5-0.5b-instruct-q4_k_m.gguf
QWEN_BIN=$HOME/llama.cpp/build/bin/llama-server
QWEN_CONTEXT=1024
QWEN_THREADS=2

# Sentence embedding server (not yet configured)
EMBED_PORT=8083
# EMBED_BIN=$HOME/...
# EMBED_MODEL=$HOME/...

# STT / Whisper server (not yet configured)
STT_PORT=8084
# STT_BIN=$HOME/...
# STT_MODEL=$HOME/...

# Metro bundler
METRO_PORT=8082
# METRO_DIR=$HOME/neuralcompose-client
