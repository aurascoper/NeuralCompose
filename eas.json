{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.11.1",
      "android": {
        "buildType": "apk",
        "gradleVersion": "8.10.2"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "gradleVersion": "8.10.2",
        "withoutCredentials": true
      }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
